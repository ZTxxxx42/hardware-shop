# 五金商贸 MVP · Docker Compose 环境变量模板
# 复制为 .env 后按环境修改;密钥/口令只经 compose 注入,不写入镜像。

# ---- 数据库 ----
POSTGRES_DB=hardware_shop
POSTGRES_USER=postgres
# 生产必须修改为强口令;含 @ : / 等特殊字符时,需 URL 编码后再拼 DATABASE_URL
POSTGRES_PASSWORD=postgres

# ---- API ----
DEBUG=false
SECRET_KEY=please-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# CORS 白名单(JSON 数组);生产改为实际站点 HTTPS 域名(同源部署通常不触发 CORS)
CORS_ORIGINS=["http://localhost","http://127.0.0.1"]
# 支付网关占位(MVP 联调时替换为真实商户配置)
WECHAT_PAY_API_V3_KEY=
ALIPAY_APP_PRIVATE_KEY=
# 容器启动时是否填充种子数据(true/false,幂等)
SEED_DATA=false

# ---- Nginx 端口 ----
HTTP_PORT=80
# HTTPS_PORT=443
