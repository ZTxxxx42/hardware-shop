# 复制为 .env 后按环境修改
DEBUG=false
SECRET_KEY=please-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hardware_shop
# CORS 白名单,JSON 数组格式
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:5175"]
# 微信小程序静默登录
WECHAT_MP_APPID=
WECHAT_MP_APPSECRET=
WECHAT_MP_JSCODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
WECHAT_MP_TIMEOUT_SECONDS=5
# 支付网关占位(MVP 联调时替换为真实商户配置)
WECHAT_PAY_API_V3_KEY=
ALIPAY_APP_PRIVATE_KEY=
