        </mxCell>

        <mxCell id="be_check" value="校验库存&#xa;按等级重算价格" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="lane-backend">
