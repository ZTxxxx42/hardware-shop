        <mxCell id="web_submit" value="提交结算请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane-web">
          <mxGeometry x="630" y="30" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="web_qr" value="展示支付二维码/收银台" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane-web">
          <mxGeometry x="1430" y="30" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="web_success" value="展示支付成功/订单结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane-web">
