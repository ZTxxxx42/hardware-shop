        <mxCell id="be_verify" value="验签 + 幂等校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="lane-backend">
          <mxGeometry x="1830" y="30" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="be_cancel" value="取消订单、回补库存&#xa;【已取消】" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="lane-backend">
          <mxGeometry x="830" y="105" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dec_pay" value="支付成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="lane-backend">
          <mxGeometry x="1830" y="100" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="be_paid" value="转已支付、扣库存、记流水&#xa;【已支付】" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="lane-backend">
          <mxGeometry x="2030" y="105" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="gw_qr" value="生成预支付单/二维码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;dashed=1;" vertex="1" parent="lane-gateway">
