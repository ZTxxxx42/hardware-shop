        <mxCell id="be_create" value="生成订单【待支付】&#xa;+ 支付单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="lane-backend">
          <mxGeometry x="1230" y="30" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="be_prepay" value="调支付网关创建预支付" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="lane-backend">
