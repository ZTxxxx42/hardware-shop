<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="下单支付流程" id="order-payment-flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="五金商贸 · 下单支付主流程（Swimlane）" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="6" width="600" height="26" as="geometry" />
        </mxCell>

        <mxCell id="lane-buyer" value="买家 Buyer" style="swimlane;startSize=30;fillColor=none;strokeColor=#999999;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="2300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lane-web" value="前台 shop-web" style="swimlane;startSize=30;fillColor=none;strokeColor=#999999;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="2300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lane-backend" value="后端 API / Service（FastAPI 单体）" style="swimlane;startSize=30;fillColor=none;strokeColor=#999999;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="2300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lane-gateway" value="支付网关（微信 / 支付宝）" style="swimlane;startSize=30;fillColor=none;strokeColor=#999999;html=1;fontStyle=1;fontSize=13;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="2300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lane-merchant" value="商家后台 admin-web" style="swimlane;startSize=30;fillColor=none;strokeColor=#999999;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="2300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="buy_browse" value="登录浏览商品&#xa;按等级取价" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="lane-buyer">
          <mxGeometry x="30" y="30" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="buy_cart" value="加入购物车" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="lane-buyer">
          <mxGeometry x="230" y="30" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="buy_settle" value="选择地址、提交结算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="lane-buyer">
          <mxGeometry x="430" y="30" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="buy_cancel" value="取消订单（待支付）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="lane-buyer">
          <mxGeometry x="830" y="30" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="buy_pay" value="完成支付&#xa;（扫码/唤起）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="lane-buyer">
          <mxGeometry x="1630" y="30" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="buy_confirm" value="确认收货&#xa;【已完成】" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="lane-buyer">
          <mxGeometry x="2030" y="30" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="web_price" value="展示等级价格" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane-web">
          <mxGeometry x="30" y="30" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="web_cart" value="购物车清单&#xa;（商品×数量）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane-web">
          <mxGeometry x="230" y="30" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="web_settle" value="结算页&#xa;（地址+金额预览）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane-web">
          <mxGeometry x="430" y="30" width="160" height="50" as="geometry" />
